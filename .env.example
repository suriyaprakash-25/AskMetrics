# Choose: ollama, mock, or gemini
ASKMETRICS_LLM_PROVIDER=ollama
ASKMETRICS_MAX_RESULT_ROWS=100
ASKMETRICS_QUERY_TIMEOUT_MS=1500
ASKMETRICS_RETRY_COUNT=1

# Ollama settings (Local Qwen3 8B)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: Gemini (if used)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
