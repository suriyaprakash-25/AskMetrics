# Choose: mock, gemini, or ollama
ASKMETRICS_LLM_PROVIDER=mock
ASKMETRICS_MAX_RESULT_ROWS=100
ASKMETRICS_QUERY_TIMEOUT_MS=1500
ASKMETRICS_RETRY_COUNT=1

# Required only for Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Required only for Ollama
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_URL=http://localhost:11434/api/chat
